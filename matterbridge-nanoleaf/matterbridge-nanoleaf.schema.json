{
  "title": "Nanoleaf devices",
  "type": "object",
  "properties": {
    "discover": { "type": "boolean", "title": "List supported Nanoleaf devices found with mDNS at startup", "default": true },
    "mdnsTimeout": { "type": "integer", "title": "mDNS discovery timeout (ms)", "default": 1500, "minimum": 250, "maximum": 10000 },
    "mdnsInterface": { "type": "string", "title": "Network interface for mDNS (optional)" },
    "devices": {
      "type": "array",
      "title": "Nanoleaf devices",
      "items": {
        "type": "object",
        "properties": {
          "host": { "type": "string" },
          "protocol": { "type": "string", "enum": ["ltpdu", "wifi-openapi"], "default": "ltpdu" },
          "deviceName": { "type": "string" },
          "model": { "type": "string" },
          "token": { "type": "string", "title": "Access token", "ui:widget": "password" },
          "pin": {
            "type": "string",
            "title": "8-digit Nanoleaf PIN (required for first LTPDU pairing)",
            "minLength": 8,
            "maxLength": 8,
            "pattern": "^[0-9]{8}$",
            "ui:widget": "password"
          }
        },
        "required": ["host", "protocol"]
      }
    },
    "pollInterval": { "type": "integer", "default": 30000, "minimum": 5000 }
  },
  "required": []
}
